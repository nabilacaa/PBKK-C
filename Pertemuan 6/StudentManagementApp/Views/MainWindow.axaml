<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudentManagementApp.ViewModels"
        xmlns:m="using:StudentManagementApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="StudentManagementApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Student Management"
        Width="1200" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="6" Height="34" CornerRadius="3" Margin="0,0,14,0"
                        Background="{DynamicResource HighlightBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Student Management" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Data mahasiswa, KRS, dan rekap program studi — SQL Server + ADO.NET"
                               FontSize="12" Foreground="#C9D6F2" />
                </StackPanel>
                <Button Grid.Column="2" Content="⟳  Muat Ulang Semua"
                        Command="{Binding LoadAllCommand}"
                        Background="#1C4FA6" Foreground="White" />
            </Grid>
        </Border>

        <!-- ================= Tab ================= -->
        <TabControl Grid.Row="1" Margin="16,8,16,0" Padding="0,8,0,8">

            <!-- TAB 1: MAHASISWA -->
            <TabItem Header="Mahasiswa" DataContext="{Binding Students}" x:DataType="vm:StudentsViewModel">
                <Grid ColumnDefinitions="340,16,*">

                    <!-- Form -->
                    <Border Grid.Column="0" Classes="card">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding FormTitle}" Classes="section" />

                                <StackPanel>
                                    <TextBlock Text="NRP" Classes="label" />
                                    <TextBox Text="{Binding Nrp}" PlaceholderText="10 digit, contoh 5025241150" MaxLength="10" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Nama Lengkap" Classes="label" />
                                    <TextBox Text="{Binding FullName}" PlaceholderText="Nama sesuai KTM" MaxLength="150" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel>
                                        <TextBlock Text="Jenis Kelamin" Classes="label" />
                                        <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Angkatan" Classes="label" />
                                        <TextBox Text="{Binding EntryYear}" MaxLength="4" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="Program Studi" Classes="label" />
                                    <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:StudyProgram">
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Email" Classes="label" />
                                    <TextBox Text="{Binding Email}" PlaceholderText="nama@student.its.ac.id" MaxLength="150" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="No. HP (opsional)" Classes="label" />
                                    <TextBox Text="{Binding PhoneNumber}" MaxLength="20" />
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <Button Content="Tambah Mahasiswa" Classes="primary" HorizontalAlignment="Stretch"
                                            Command="{Binding AddCommand}" IsEnabled="{Binding !IsEditing}" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button Content="Update" Classes="secondary" HorizontalAlignment="Stretch"
                                                Command="{Binding UpdateCommand}" IsEnabled="{Binding IsEditing}" />
                                        <Button Grid.Column="2" Content="Hapus" Classes="danger" HorizontalAlignment="Stretch"
                                                Command="{Binding DeleteCommand}" IsEnabled="{Binding IsEditing}" />
                                    </Grid>
                                    <Button Content="Bersihkan Form" Classes="ghost" HorizontalAlignment="Center"
                                            Command="{Binding ClearFormCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Tabel -->
                    <Border Grid.Column="2" Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Daftar Mahasiswa" Classes="section" />
                                    <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} data · pilih baris untuk mengedit'}"
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="240" Text="{Binding SearchText}"
                                         PlaceholderText="Cari NRP, nama, atau email">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2" Content="Cari" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedStudent}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NRP" x:DataType="m:Student" Binding="{Binding Nrp}" Width="Auto" />
                                    <DataGridTextColumn Header="Nama Lengkap" x:DataType="m:Student" Binding="{Binding FullName}" Width="*" MinWidth="140" />
                                    <DataGridTextColumn Header="L/P" x:DataType="m:Student" Binding="{Binding Gender}" Width="Auto" />
                                    <DataGridTextColumn Header="Prodi" x:DataType="m:Student" Binding="{Binding ProgramCode}" Width="Auto" />
                                    <DataGridTextColumn Header="Angkatan" x:DataType="m:Student" Binding="{Binding EntryYear}" Width="Auto" />
                                    <DataGridTextColumn Header="Email" x:DataType="m:Student" Binding="{Binding Email}" Width="1.4*" MinWidth="170" />
                                    <DataGridTextColumn Header="Terdaftar" x:DataType="m:Student"
                                                        Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: KRS -->
            <TabItem Header="KRS" DataContext="{Binding Enrollments}" x:DataType="vm:EnrollmentsViewModel">
                <Grid ColumnDefinitions="340,16,*">

                    <!-- Form -->
                    <Border Grid.Column="0" Classes="card">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Pengambilan Mata Kuliah" Classes="section" />

                                <StackPanel>
                                    <TextBlock Text="Mahasiswa" Classes="label" />
                                    <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                                              PlaceholderText="Pilih mahasiswa">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:Student">
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Mata Kuliah" Classes="label" />
                                    <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                              PlaceholderText="Pilih mata kuliah">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:Course">
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel>
                                        <TextBlock Text="Tahun Ajaran" Classes="label" />
                                        <TextBox Text="{Binding AcademicYear}" MaxLength="9" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Semester" Classes="label" />
                                        <ComboBox ItemsSource="{Binding Terms}" SelectedItem="{Binding Term}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="Nilai" Classes="label" />
                                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding Grade}" />
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <Button Content="Ambil Mata Kuliah" Classes="primary" HorizontalAlignment="Stretch"
                                            Command="{Binding AddCommand}" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button Content="Update Nilai" Classes="secondary" HorizontalAlignment="Stretch"
                                                Command="{Binding UpdateGradeCommand}" IsEnabled="{Binding HasSelection}" />
                                        <Button Grid.Column="2" Content="Hapus" Classes="danger" HorizontalAlignment="Stretch"
                                                Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" />
                                    </Grid>
                                    <Button Content="Bersihkan Form" Classes="ghost" HorizontalAlignment="Center"
                                            Command="{Binding ClearFormCommand}" />
                                </StackPanel>

                                <Separator Margin="0,4" />
                                <CheckBox Content="Tampilkan KRS mahasiswa terpilih saja"
                                          IsChecked="{Binding FilterBySelectedStudent}" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Ringkasan + tabel -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
                        <Grid ColumnDefinitions="*,10,*,10,*">
                            <Border Classes="stat">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalCourses}" Classes="stat-value" />
                                    <TextBlock Text="Mata kuliah diambil" Classes="stat-label" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="stat">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalCredits}" Classes="stat-value" />
                                    <TextBlock Text="Total SKS" Classes="stat-label" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="stat">
                                <StackPanel>
                                    <TextBlock Text="{Binding GpaText}" Classes="stat-value" />
                                    <TextBlock Text="IPK (MK bernilai)" Classes="stat-label" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Classes="card" Padding="0">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Margin="16,12">
                                    <TextBlock Text="Data KRS" Classes="section" />
                                    <TextBlock Text="{Binding SummaryCaption}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                                          SelectedItem="{Binding SelectedEnrollment}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NRP" x:DataType="m:EnrollmentDetail" Binding="{Binding Nrp}" Width="Auto" />
                                        <DataGridTextColumn Header="Nama" x:DataType="m:EnrollmentDetail" Binding="{Binding FullName}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="Kode" x:DataType="m:EnrollmentDetail" Binding="{Binding CourseCode}" Width="Auto" />
                                        <DataGridTextColumn Header="Mata Kuliah" x:DataType="m:EnrollmentDetail" Binding="{Binding CourseName}" Width="1.6*" MinWidth="170" />
                                        <DataGridTextColumn Header="SKS" x:DataType="m:EnrollmentDetail" Binding="{Binding Credits}" Width="Auto" />
                                        <DataGridTextColumn Header="Periode" x:DataType="m:EnrollmentDetail" Binding="{Binding Period}" Width="Auto" />
                                        <DataGridTextColumn Header="Nilai" x:DataType="m:EnrollmentDetail" Binding="{Binding GradeText}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: RINGKASAN -->
            <TabItem Header="Rekap Prodi" DataContext="{Binding Summary}" x:DataType="vm:SummaryViewModel">
                <Border Classes="card" Padding="0" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                            <StackPanel>
                                <TextBlock Text="Jumlah Mahasiswa per Program Studi" Classes="section" />
                                <TextBlock Text="{Binding TotalStudents, StringFormat='{}Hasil query LEFT JOIN + GROUP BY + COUNT · total {0} mahasiswa'}"
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Muat Ulang" Command="{Binding LoadCommand}" />
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode" x:DataType="m:ProgramSummary" Binding="{Binding ProgramCode}" Width="90" />
                                <DataGridTextColumn Header="Program Studi" x:DataType="m:ProgramSummary" Binding="{Binding ProgramName}" Width="*" />
                                <DataGridTextColumn Header="Jumlah Mahasiswa" x:DataType="m:ProgramSummary" Binding="{Binding StudentCount}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="20,8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center"
                        Classes.dot-ok="{Binding IsSuccess}" Classes.dot-err="{Binding !IsSuccess}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ServerInfo}" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
